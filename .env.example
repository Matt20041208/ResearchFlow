# Copy this file to .env and fill in your own key.
OPENAI_API_KEY=your-deepseek-api-key
SPRING_AI_MODEL_CHAT=openai
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# Optional MCP Client (remote SSE transport)
RESEARCH_FLOW_MCP_ENABLED=false
RESEARCH_FLOW_MCP_URL=http://localhost:9000

# Optional ResearchFlow MCP Server
RESEARCH_FLOW_MCP_SERVER_ENABLED=false
